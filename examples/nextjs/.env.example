# Authentication > Developers in the Didit console. Use your Sandbox
# application while you build: its sign-ins never reach live users.
DIDIT_PUBLISHABLE_KEY=pk_test_your_key
# Your Frontend API: your hosted sign-in domain, or until it is set up,
# https://<api host>/auth/v2/authentication/<application id>
DIDIT_FRONTEND_API=https://your-app.sandbox.auth.didit.me
# Register this exact address as a redirect address of the application.
DIDIT_REDIRECT_URI=http://localhost:3000/auth/callback
