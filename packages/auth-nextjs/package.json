{
  "name": "@didit-protocol/auth-nextjs",
  "version": "0.1.0",
  "description": "Didit Authentication for Next.js: components, server-side auth() and a proxy with httpOnly session cookies",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-server": "./dist/index.server.js",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "jest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "keywords": [
    "didit",
    "authentication",
    "nextjs",
    "react",
    "sign-in"
  ],
  "author": "Didit",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/didit-protocol/sdk-web.git",
    "directory": "packages/auth-nextjs"
  },
  "homepage": "https://docs.didit.me",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@didit-protocol/auth-react": "0.1.0"
  },
  "peerDependencies": {
    "next": "^15.5.0 || ^16.0.0",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.0",
    "next": "^16.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
